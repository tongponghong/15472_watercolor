float C(ivec2 p){
    if (vert){
        return float(imageLoad(Ci, p).b > 0.4);
    } else {
       return float(imageLoad(Ci, p).g > 0.4);
    }
}

float linearize(float z){
    return (2.0 * near) / (far + near - z * (far - near));
}

float Z(ivec2 p){
    return linearize(texelFetch(Zi, p, 0).r);
}

vec4 B(ivec2 p){
    return imageLoad(Bi, p);
}

vec4 I(ivec2 p){
    if (vert){
        return imageLoad(Ii, p);
    } else {
        return imageLoad(Bi, p);
    }
}

float W(int i){
    return kernel[i];
}

//* color image I
//* depth image Z
//* control image mask C
//* depth threshold T
//* matches pseudo code from page 7/13
void bleedBlur(ivec2 p){
    float T = 0.001;
    vec4 result = vec4(0.0);
    ivec2 size = imageSize(Ii);

    ivec2 change;
    if (vert){
        change = ivec2(1, 0);
    } else {
        change = ivec2(0, 1);
    }

    float countBehind = 0.0;
    for (int i = -10; i <= 10; i++){

        
        ivec2 p_i = p + i*change;
        if (p_i.x < 0 || p_i.x >= size.x) continue;
        
        if (C(p) > 0 || C(p_i) > 0){
            //* perform bleed and depth queries
            bool bleed = false;
            bool sourceBehind = Z(p) - T > Z(p_i);

            if (sourceBehind){
                countBehind += 0.1;
            }

            bool accurateToPaper = true;
            
            if (accurateToPaper){
                if (C(p_i) > 0 && sourceBehind){
                    bleed = true;
                } else if (C(p) > 0 && !sourceBehind){
                    bleed = true;
                }
            } else {
                if (C(p_i) > 0 && !sourceBehind){
                    bleed = true;
                } else if (C(p) > 0 && !sourceBehind){
                    bleed = true;
                }
            }
            
            if (bleed){
                result += I(p_i) * W(i+10);
            } else {
                result += I(p) * W(i+10);
            }

        } else {
            //* add weighted source color
            result += I(p) * W(i+10);
        }
    }
    //imageStore(Bi, p, vec4(countBehind, 0.0, 0.0, 1.0));
    imageStore(Bi, p, result);
}

void main(){
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    //* texelFetch(Zi, texelCoord, 0).r
    
    bleedBlur(p);
    //imageStore(Bi, p, vec4(Z(p)));
