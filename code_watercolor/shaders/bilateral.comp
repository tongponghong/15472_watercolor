layout(push_constant) uniform Push {
    bool vert;
    float near;
    float far;
};


layout(local_size_x = 8, local_size_y = 8) in;
layout(binding=0) readonly uniform image2D Ii; // color image
layout(binding=1) uniform image2D Ci; // control image
layout(binding=2) uniform sampler2D Zi; // depth image

layout(binding=3) uniform image2D Bi; // bleed image


//* paper uses kernel size 21 with stdev 20
float kernel[] = float[](0.043958, 0.045015, 0.045981, 0.046852, 0.047619, 0.048279, 0.048825, 0.049254, 0.049563, 0.049749, 0.049811, 0.049749, 0.049563, 0.049254, 0.048825, 0.048279, 0.047619, 0.046852, 0.045981, 0.045015, 0.043958);

