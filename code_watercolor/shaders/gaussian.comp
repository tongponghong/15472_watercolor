// //* this will be precomputed on CPU later (or set as constants)
float G(float x, float y, float stdev){
    float coors = x*x + y*y;
    float stdevSq = stdev*stdev;
    float frac = (-1.0f * coors)/(stdevSq*2.0f);
    float g = (1.0f / (2.0f * PI * stdevSq)) * exp(frac);
    return g;
}

//* can be split into horizontal/vertical as needed
vec3 gaussianBlur(int x, int y){
    //* create kernel
    // float kernel[kernelSize * kernelSize]; 
    // float sum = 0.0f;
    // for (int i = 0; i < kernelSize; i++){
    //     for (int j = 0; j < kernelSize; j++){
    //         float g = G(i - halfSize, j - halfSize, stdev);
    //         kernel[i * kernelSize + j] = g;
    //         sum += g;
    //     }
    // }

    // //* normalize
    // for (int i = 0; i < kernelSize; i++){
    //     for (int j = 0; j < kernelSize; j++){
    //         kernel[i * kernelSize + j] /= sum;
    //     }
    // }

    // convolve
    ivec2 size = imageSize(inputImage);
    vec4 total = vec4(0.0);
    for (int i = 0; i < kernelSize; i++){
        for (int j = 0; j < kernelSize; j++){
            float weight = kernel[i * kernelSize + j];
            ivec2 pos = clamp(
                ivec2(x + i - halfSize, y + j - halfSize),
                ivec2(0),
                size - 1
            );
            vec4 value = imageLoad(inputImage, pos);
            total += value * weight;
        }
    }

    return total.xyz;
}

vec2 random22(vec2 p){
   return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3))))*43758.5453);
}


//* Function directly from https://thebookofshaders.com/11/
vec2 simplex(vec2 st){
   vec2 fst = floor(st);
   vec2 a = random22(fst);
   vec2 b = random22(fst + vec2(1.0, 0.0));
   vec2 c = random22(fst + vec2(0.0, 1.0));
   vec2 d = random22(fst + vec2(1.0, 1.0));
   vec2 fr = fract(st);
   vec2 u = fr*fr*(3.0-2.0*fr);
   return mix(a, b, u.x) + (c-a)*u.y *(1.0-u.x) + (d-b)*u.x*u.y;
}


void main(){
    vec4 value = vec4(0.0, 0.0, 0.0, 1.0);
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    vec4 I = imageLoad(inputImage, texelCoord);

    vec4 B = vec4(gaussianBlur(texelCoord.x, texelCoord.y), 1.0f);

    float ctrl = 0.2;
    vec4 Icb = I + (B-I)*ctrl;

    vec3 blurred = gaussianBlur(texelCoord.x, texelCoord.y);
    vec4 diff = max(B - I, vec4(0.0));

    // max RGB channel
    float edge = max(max(diff.r, diff.g), diff.b);

    // apply darkening

    //vec4 Ied = I * edge;
    vec4 darken = I*vec4(100/255,50/255,30/255,255/255);

    vec4 stuff = mix(I, B, simplex(texelCoord).x);
    vec4 Ied = mix(stuff,vec4(0), edge);
    //vec4(blurred,1)

    imageStore(outputImage, texelCoord, Ied);
}

